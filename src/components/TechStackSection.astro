---
import Section from './Section.astro';
import TechStack from './TechStack.astro';
import { backendDevTechStacks, mobileDevTechStacks, webDevTechStacks } from '../data/tech-stacks';
---

<Section class="tech-stack-section" number="02" title="Personal Tech Stacks">
    <div class="tech-stack-section__list">
        <TechStack header="Web" techStacks={webDevTechStacks} />
        <TechStack header="Mobile" techStacks={mobileDevTechStacks} />
        <TechStack header="Backend" techStacks={backendDevTechStacks} />
    </div>
</Section>
