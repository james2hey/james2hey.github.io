---
import { Picture } from 'astro:assets';
import type { ProjectData } from '../data/projects';

interface Props {
    project: ProjectData;
}

const { project } = Astro.props;
---

<article class="project-list-item reveal">
    <div class="project-list-item__brief">
        <h3>{project.name}</h3>
        <Picture
            class="project-list-item__image"
            src={project.image}
            alt={project.name}
            width={120}
            densities={[1, 2]}
            formats={['avif', 'webp']}
        />
    </div>
    <div class="project-list-item__details">
        <p class="project-list-item__details-content">{project.content}</p>
        <p class="project-list-item__technologies">{project.technologies.join(' · ')}</p>
    </div>
</article>
