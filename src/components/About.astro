---
import Icon from './Icon.astro';
import Section from './Section.astro';

const values = [
    {
        title: 'Developer experience',
        description: 'Clear conventions and tooling, so the right way to build is also the easiest way.',
        iconName: 'pragmatic'
    },
    {
        title: 'Shipping safely',
        description: 'Every change tested and rolled out gradually, with a quick way back if something goes wrong.',
        iconName: 'agile'
    },
    {
        title: 'Accessibility',
        description: 'Frontends that everyone can use.',
        iconName: 'computer'
    }
];
---

<Section class="about" id="about" number="01" title="About">
    <div class="about__description reveal">
        <p>
            I'm a senior software engineer on Twilio's frontend platform team in London. I build the foundations other
            engineers ship on: a micro-frontend architecture, a large monorepo with shared conventions, and CI/CD
            pipelines that test every change and roll it out gradually. More than 20 teams build and release through it,
            frequently and safely.
        </p>
        <p>
            Before that I built React components and then Java backend services at Twilio. I started out at Vista in New
            Zealand, growing from intern to mid-level engineer while building React and React Native apps.
        </p>
    </div>
    <h3 class="about__subtitle reveal">What I care about</h3>
    <div class="about__container">
        {values.map(({ title, description, iconName }) => (
            <div class="about-item reveal">
                <Icon class="about-item__image" name={iconName} />
                <h3 class="about-item__heading">{title}</h3>
                <p class="about-item__description">{description}</p>
            </div>
        ))}
    </div>
</Section>
