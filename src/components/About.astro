---
import Icon from './Icon.astro';
import Section from './Section.astro';

const passions = [
    {
        title: 'Agility',
        description: 'Welcoming new requirements. Software should be flexible and adaptable.',
        iconName: 'agile'
    },
    {
        title: 'High quality tests',
        description: 'Using tests to drive the implementation of software to ensure confidence.',
        iconName: 'pragmatic'
    },
    {
        title: 'Accessibility',
        description: 'Creating front-end applications that are inclusive for everyone to use.',
        iconName: 'computer'
    }
];
---

<Section class="about" id="about">
    <h2 class="about__title">About</h2>
    <p class="about__description">
        A software engineer with experience across the full software development lifecycle. Driven to pragmatically
        deliver software solutions with agility to meet evolving client requirements. Strongly skilled with front end
        technologies and passionate about UX design.
    </p>
    <h3 class="about__title">Software Passions</h3>
    <div class="about__container">
        {passions.map(({ title, description, iconName }) => (
            <div class="about-item">
                <Icon class="about-item__image" name={iconName} />
                <h3 class="about-item__heading">{title}</h3>
                <p class="about-item__description">{description}</p>
            </div>
        ))}
    </div>
</Section>
