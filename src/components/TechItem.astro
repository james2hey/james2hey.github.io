---
import Icon from './Icon.astro';

interface Props {
    name: string;
    iconName: string;
    showName?: boolean;
}

const { name, iconName, showName = false } = Astro.props;
---

<div class:list={['tech-item', { 'tech-item--show-name': showName }]}>
    <Icon name={iconName} class="tech-item__icon" label={showName ? undefined : name} />
    {showName && <p class="tech-item__text">{name}</p>}
</div>
