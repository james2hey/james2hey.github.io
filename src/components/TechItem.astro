---
import Icon from './Icon.astro';

interface Props {
    name: string;
    iconName: string;
    showName?: boolean;
}

const { name, iconName, showName = false } = Astro.props;
---

<!-- Spans rather than div/p so a tech item can sit inside a button. -->
<span class:list={['tech-item', { 'tech-item--show-name': showName }]}>
    <Icon name={iconName} class="tech-item__icon" label={showName ? undefined : name} />
    {showName && <span class="tech-item__text">{name}</span>}
</span>
