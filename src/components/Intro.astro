---
import { Picture } from 'astro:assets';
import portrait from '../assets/images/portrait.jpg';
---

<header class="intro">
    <div class="intro__mesh" aria-hidden="true"></div>
    <div class="intro__spotlight" aria-hidden="true">
        <div class="intro__spotlight-layer"></div>
    </div>
    <div class="intro__container">
        <div class="profile-picture">
            <Picture
                src={portrait}
                alt="Profile picture"
                class="profile-picture__image"
                width={160}
                height={160}
                densities={[1, 2]}
                formats={['avif', 'webp']}
                loading="eager"
                fetchpriority="high"
            />
        </div>
        <h1 class="intro__main-heading">
            Kia ora, I'm <span class="highlight">James Toohey</span>.
        </h1>
        <h2 class="intro__subheading">
            Senior Software Engineer at Twilio · a Kiwi in London<span class="intro__flag">🇳🇿</span>
        </h2>
        <div class="intro__actions">
            <a class="button button--color-primary" href="#about">
                About Me
            </a>
            <a class="button button--color-secondary" href="#contact">
                Get in touch
            </a>
        </div>
    </div>
    <!-- A mouse affordance only: "About Me" already goes to the same place for keyboard and screen reader users. -->
    <a class="intro__scroll-cue" href="#about" aria-hidden="true" tabindex="-1">
        <span class="intro__scroll-cue-arrow"></span>
    </a>
</header>

<script>
    // Moves the mesh spotlight towards the cursor with a little easing. Only transforms change, so the browser
    // just moves existing layers instead of repainting. Touch devices skip this and keep the plain drift.
    const intro = document.querySelector<HTMLElement>('.intro');
    const spotlight = document.querySelector<HTMLElement>('.intro__spotlight');
    const layer = spotlight?.firstElementChild as HTMLElement | null;

    if (intro && spotlight && layer && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const easing = 0.15;
        // Page coordinates, so the position stays right if the page scrolls while the pointer is over the intro.
        const toLocal = (event: PointerEvent) => ({
            x: event.pageX - intro.offsetLeft,
            y: event.pageY - intro.offsetTop
        });
        // A pause longer than this between moves means the pointer went somewhere else (e.g. out of the window)
        // without us being told, so the next move is treated as a fresh entry.
        const reentryGap = 150;
        let target = { x: 0, y: 0 };
        let current = { x: 0, y: 0 };
        let frame = 0;
        let active = false;
        let lastMove = 0;
        // Measured on each entry, not when the script first runs: Safari can run this before the stylesheet has
        // applied, when the spotlight is still a full-width block rather than a 320px circle.
        let radius = 0;

        const place = () => {
            spotlight.style.transform = `translate(${current.x - radius}px, ${current.y - radius}px)`;
            layer.style.transform = `translate(${radius - current.x}px, ${radius - current.y}px)`;
        };

        const render = () => {
            current.x += (target.x - current.x) * easing;
            current.y += (target.y - current.y) * easing;
            place();

            const settled = Math.abs(target.x - current.x) < 0.5 && Math.abs(target.y - current.y) < 0.5;
            frame = settled ? 0 : requestAnimationFrame(render);
        };

        // Jump straight to the pointer and fade in from nothing, rather than sliding over from wherever the
        // spotlight was last (or reappearing mid fade-out).
        const enter = () => {
            active = true;
            current = { ...target };
            spotlight.style.transition = 'none';
            spotlight.classList.remove('is-active');
            // Reading the size also applies the hidden state before the transition is turned back on.
            radius = spotlight.offsetWidth / 2;
            place();
            spotlight.style.transition = '';
            spotlight.classList.add('is-active');
        };

        const leave = () => {
            active = false;
            spotlight.classList.remove('is-active');
        };

        // Started from pointermove rather than pointerenter: if the pointer is already over the intro when the
        // page loads, Safari never fires pointerenter.
        intro.addEventListener('pointermove', event => {
            if (event.pointerType === 'touch') return;
            target = toLocal(event);
            if (!active || event.timeStamp - lastMove > reentryGap) enter();
            lastMove = event.timeStamp;
            if (!frame) frame = requestAnimationFrame(render);
        });

        // Browsers don't all fire pointerleave when the pointer leaves the window, so also listen for the window
        // itself being left, losing focus, or being hidden.
        intro.addEventListener('pointerleave', leave);
        document.addEventListener('pointerout', event => {
            if (!event.relatedTarget) leave();
        });
        window.addEventListener('blur', leave);
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) leave();
        });
    }
</script>
