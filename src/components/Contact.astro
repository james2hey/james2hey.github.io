---
import Icon from './Icon.astro';
import Section from './Section.astro';

const links = [
    { href: 'mailto:james@toohey.dev', icon: 'mail', label: 'Email' },
    { href: 'https://linkedin.com/in/james-toohey-01997', icon: 'linkedin', label: 'LinkedIn' },
    { href: 'https://github.com/james2hey', icon: 'github', label: 'GitHub' }
];
---

<Section class="contact" id="contact" number="04" title="Let's talk">
    <address class="contact__details reveal">
        <p class="contact__brief">
            Got a question about my projects? Want to hear more about me? I'd love to have a chat. Feel free to connect
            with me on LinkedIn or send an email!
        </p>
        <div class="contact__external-links">
            {links.map(({ href, icon, label }) => (
                <div class="contact__external-link-wrapper">
                    <a href={href}>
                        <Icon name={icon} class="contact__external-link-image" label={label} />
                    </a>
                </div>
            ))}
        </div>
    </address>
</Section>
